# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://example-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only authorization and provider credentials
OWNER_USER_ID=00000000-0000-0000-0000-000000000000
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
CODEX_PREPARATION_TOKEN=replace-with-at-least-32-random-characters
RESEND_API_KEY=server-only-resend-key
RESEND_WEBHOOK_SECRET=server-only-webhook-secret
ALERT_RECIPIENT=verified-recipient@example.invalid
RADAR_EMAIL_FROM="Internship Radar <onboarding@resend.dev>"
RADAR_DASHBOARD_URL=https://radar.example.invalid
# Local CLI only: libpq URL used by `radar backup`; never expose this to the browser.
RADAR_DATABASE_URL=postgresql://postgres:replace-with-private-password@example.invalid:5432/postgres

# Fail-closed free-tier safety limits
RADAR_EMAIL_DAILY_CAP=50
RADAR_EMAIL_MONTHLY_CAP=2500
RADAR_DATABASE_SOFT_LIMIT_MB=400
RADAR_STORAGE_SOFT_LIMIT_MB=800

# Poller scheduling and fair-use controls
RADAR_PARTITION_COUNT=8
RADAR_PER_DOMAIN_CONCURRENCY=2

# One-time tracker cutover only. Keep unset except during an authorized import.
RADAR_MIGRATION_APPLY_CONFIRM=
